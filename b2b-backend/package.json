{
  "name": "b2b-backend",
  "version": "1.0.0",
  "description": "B2B + B2C E-commerce Backend",
  "main": "server.js",
  "type": "module",
  "engines": {
    "node": "24.14.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "cross-env NODE_ENV=test NODE_OPTIONS=--experimental-vm-modules jest --config jest.config.json",
    "test:watch": "cross-env NODE_ENV=test NODE_OPTIONS=--experimental-vm-modules jest --watch --config jest.config.json",
    "test:coverage": "cross-env NODE_ENV=test NODE_OPTIONS=--experimental-vm-modules jest --coverage --config jest.config.json",
    "test:unit": "cross-env NODE_ENV=test NODE_OPTIONS=--experimental-vm-modules jest tests/unit --config jest.config.json",
    "test:integration": "cross-env NODE_ENV=test NODE_OPTIONS=--experimental-vm-modules jest tests/integration --config jest.config.json",
    "test:e2e": "cross-env NODE_ENV=test NODE_OPTIONS=--experimental-vm-modules jest tests/e2e --config jest.config.json",
    "test:load": "node tests/load/load-test.js",
    "lint": "eslint . --ext .js",
    "lint:fix": "eslint . --ext .js --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky || true",
    "precommit": "lint-staged",
    "validate": "npm run lint && npm run format:check && npm run test:coverage"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "@otplib/preset-default": "^12.0.1",
    "@sentry/node": "^8.48.0",
    "@sentry/profiling-node": "^8.48.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.41.6",
    "compression": "^1.8.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "http-status": "^2.1.0",
    "ioredis": "^5.5.0",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^9.6.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^3.0.3",
    "otp-generator": "^4.0.1",
    "otplib": "^12.0.1",
    "pdfkit": "^0.18.0",
    "qrcode": "^1.5.4",
    "razorpay": "^2.9.6",
    "redis": "^5.0.0",
    "socket.io": "^4.8.3",
    "speakeasy": "^2.0.0",
    "validator": "^13.12.0",
    "winston": "^3.17.0",
    "xss-clean": "^0.1.4"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "autocannon": "^7.15.0",
    "cross-env": "^10.1.0",
    "eslint": "^9.20.1",
    "husky": "^9.1.7",
    "ioredis-mock": "^8.9.0",
    "jest": "^30.4.2",
    "lint-staged": "^15.2.11",
    "mongodb-memory-server": "^10.1.4",
    "nodemon": "^3.1.9",
    "prettier": "^3.5.1",
    "supertest": "^7.0.0"
  },
  "overrides": {
    "axios": ">=1.15.2"
  }
}
