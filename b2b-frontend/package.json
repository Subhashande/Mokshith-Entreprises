{
  "name": "b2b-frontend",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext .js,.jsx || echo 'ESLint not configured'",
    "lint:fix": "eslint . --ext .js,.jsx --fix || echo 'ESLint not configured'",
    "format": "prettier --write \"src/**/*.{js,jsx,css}\" || echo 'Prettier not configured'",
    "format:check": "prettier --check \"src/**/*.{js,jsx,css}\" || echo 'Prettier not configured'",
    "test": "echo 'Tests not yet implemented - consider adding Vitest' && exit 0",
    "analyze": "vite build --mode analyze",
    "docker:build": "docker build -t b2b-frontend:latest .",
    "docker:run": "docker run -p 3000:80 b2b-frontend:latest"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.11.2",
    "@sentry/react": "^10.55.0",
    "@vitejs/plugin-react": "^6.0.1",
    "axios": "^1.15.1",
    "lucide-react": "^1.8.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-redux": "^9.2.0",
    "react-router-dom": "^7.14.1",
    "socket.io-client": "^4.8.3",
    "vite": "^8.0.8"
  },
  "devDependencies": {
    "@sentry/vite-plugin": "^5.3.0",
    "@tailwindcss/postcss": "^4.2.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@vitest/ui": "^4.1.7",
    "autoprefixer": "^10.5.0",
    "esbuild": "^0.28.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.10",
    "vitest": "^4.1.8"
  }
}
